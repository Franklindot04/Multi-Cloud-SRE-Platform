#!/usr/bin/env bash
# A fake kubectl for scripts/test-scripts.sh. It answers only the exact calls scripts/teardown-prep.sh and
# scripts/teardown-argocd.sh are expected to make and exits 99 for anything else, so a new or changed call shows
# up as a test failure.
#
# State lives in the directory $FAKE_STATE. Every call is appended to $FAKE_STATE/kubectl.log (with the
# --context argument). Marker files model the cluster:
#   contexts            one context name per line
#   crds                one CRD name per line
#   no-secret           the Argo CD cluster Secret does not exist
#   stuck-apps          Applications never go away
#   stuck-shop          the shop namespace never empties
#   stuck-pods          a pod in the data namespace never goes away
#   stuck-pv            a PersistentVolume never goes away
#   mq-survives         the RabbitMQ StatefulSet outlives the RabbitmqCluster
#   cnpg-operator-up    a CloudNativePG operator pod is Running (without it the operator is gone)
#   mq-operator-up      a RabbitMQ Cluster Operator pod is Running
#   operator-api-error  asking for the operator pods fails
#   stuck-databases     the Database objects carry cnpg.io/deleteDatabase, which only a running operator removes
#   stuck-mq            the RabbitmqCluster carries its operator finalizer, which only a running operator removes
#   odd-finalizer-databases, odd-finalizer-mq
#                       the object also carries example.com/keep, which nothing here can remove
#   obs-namespace       the observability namespace exists (without it the observability steps find nothing to do)
#   obs-persistent      Prometheus and Grafana have claims in the observability namespace (values-persistent.yaml)
#   stuck-obs-pods      a pod in the observability namespace never goes away
#   no-pv               kubectl get pv lists nothing even while the claims in the data namespace exist
# For scripts/teardown-argocd.sh (the marker argocd-script switches the Application list to this model):
#   ns-data, ns-shop, ns-argocd
#                       these namespaces exist (the observability one is obs-namespace); deleting one creates
#                       ns-<name>-deleted, and it is gone from then on unless stuck-ns-<name> is set. The argocd
#                       namespace also stays while an AppProject still has a finalizer.
#   storageclass        the storage class platform-data exists
#   argo-controller-up  the Argo CD application controller has a Running pod until helm uninstalls the release
#                       (or, with helm-not-found, from the start: the release is not there)
#   stuck-argo-apps     the Applications platform-root and argocd carry resources-finalizer.argocd.argoproj.io and
#                       are not removed by anything but a patch, even with the controller up
#   odd-finalizer-argo, odd-finalizer-projects
#                       the Applications (the AppProjects) also carry example.com/keep, listed first
#   undeleted-argo-app  an Application named unmanaged exists that is not being deleted and has the finalizer
#   stuck-projects      the five AppProjects carry the Argo CD finalizer
# Deleting the Application platform-root creates root-deleted, and the other Applications are gone from then on
# (unless stuck). Deleting an ApplicationSet creates appsets-deleted.
# Deleting things creates labels-removed, pg-deleted, sts-deleted, pvc-deleted and obs-pvc-deleted. Deleting a Database or a
# RabbitmqCluster creates deleting-<object>; the object is gone once it has no finalizer left (deleted-<object>),
# and patching out the operator finalizer creates cleared-<object>.
set -eu

state="${FAKE_STATE:?FAKE_STATE is not set}"
echo "$*" >> "$state/kubectl.log"

flag() { [ -e "$state/$1" ]; }
mark() { : > "$state/$1"; }
unexpected() {
  echo "fake kubectl: unexpected call: $*" >&2
  exit 99
}

db_orders=database.postgresql.cnpg.io/platform-pg-orders
db_payments=database.postgresql.cnpg.io/platform-pg-payments
mq=rabbitmqcluster.rabbitmq.com/platform-mq

key() { printf '%s' "$1" | tr '/.' '__'; }

operator_up_for() {
  case "$1" in
    database.*) flag cnpg-operator-up ;;
    rabbitmqcluster.*) flag mq-operator-up ;;
    *) return 1 ;;
  esac
}

# remaining OBJECT: the finalizers the object still has, one per line. The operator finalizer is held until a
# running operator or a patch removes it; the other one is never removed.
remaining() {
  local obj="$1" known stuck odd first=0
  case "$obj" in
    database.postgresql.cnpg.io/*)
      known=cnpg.io/deleteDatabase stuck=stuck-databases odd=odd-finalizer-databases
      ;;
    rabbitmqcluster.rabbitmq.com/*)
      known=deletion.finalizers.rabbitmqclusters.rabbitmq.com stuck=stuck-mq odd=odd-finalizer-mq
      ;;
    application.argoproj.io/*)
      # The controller is never modelled as removing this finalizer: only a patch does.
      known=resources-finalizer.argocd.argoproj.io stuck=stuck-argo-apps odd=odd-finalizer-argo first=1
      if [ "$obj" = application.argoproj.io/unmanaged ]; then stuck=undeleted-argo-app; fi
      ;;
    appproject.argoproj.io/*)
      known=resources-finalizer.argocd.argoproj.io stuck=stuck-projects odd=odd-finalizer-projects first=1
      ;;
    *) return 0 ;;
  esac
  if [ "$first" -eq 1 ] && flag "$odd"; then echo example.com/keep; fi
  if flag "$stuck" && ! flag "cleared-$(key "$obj")" && ! operator_up_for "$obj"; then echo "$known"; fi
  if [ "$first" -eq 0 ] && flag "$odd"; then echo example.com/keep; fi
  return 0
}

# exists OBJECT: succeeds while the object is still there. A deleted object goes once no finalizer is left.
exists() {
  local k
  k="$(key "$1")"
  if flag "deleted-$k"; then return 1; fi
  if flag "deleting-$k" && [ -z "$(remaining "$1")" ]; then
    mark "deleted-$k"
    return 1
  fi
  return 0
}

# argo_app_present NAME: whether the Application exists in the model of scripts/teardown-argocd.sh. Before
# platform-root is deleted every one is there; afterwards only those that still have a finalizer.
argo_app_present() {
  case "$1" in
    unmanaged) flag undeleted-argo-app ;;
    cert-manager-in-cluster) ! flag root-deleted ;;
    *) ! flag root-deleted || [ -n "$(remaining "application.argoproj.io/$1")" ] ;;
  esac
}

argo_projects="platform-addons platform-apps platform-data platform-observability platform-system"

projects_hold() {
  local p
  for p in $argo_projects; do
    [ -z "$(remaining "appproject.argoproj.io/$p")" ] || return 0
  done
  return 1
}

# ns_present NAMESPACE: whether the namespace still exists.
ns_present() {
  local ns="$1" marker
  case "$ns" in
    observability) marker=obs-namespace ;;
    data | shop | argocd) marker="ns-$ns" ;;
    *) return 1 ;;
  esac
  flag "$marker" || return 1
  flag "ns-$ns-deleted" || return 0
  if flag "stuck-ns-$ns"; then return 0; fi
  if [ "$ns" = argocd ] && projects_hold; then return 0; fi
  return 1
}

if [ "${1:-}" = "--context" ]; then
  shift 2
fi

case "$*" in
  "config get-contexts -o name")
    cat "$state/contexts"
    ;;
  "-n argocd get secret cluster-in-cluster -o name")
    if flag no-secret; then
      echo 'Error from server (NotFound): secrets "cluster-in-cluster" not found' >&2
      exit 1
    fi
    echo secret/cluster-in-cluster
    ;;
  "-n argocd label secret cluster-in-cluster platform.example/apps- platform.example/data- platform.example/observability-")
    mark labels-removed
    echo "secret/cluster-in-cluster unlabeled"
    ;;
  "-n argocd get applications.argoproj.io -o name")
    if flag argocd-script; then
      for a in platform-root argocd cert-manager-in-cluster unmanaged; do
        if argo_app_present "$a"; then echo "application.argoproj.io/$a"; fi
      done
    elif flag labels-removed && ! flag stuck-apps; then
      echo "application.argoproj.io/cert-manager-in-cluster"
    else
      printf '%s\n' application.argoproj.io/apps-orders-in-cluster application.argoproj.io/data-postgres-in-cluster \
        application.argoproj.io/observability-stack-in-cluster application.argoproj.io/cert-manager-in-cluster
    fi
    ;;
  "-n argocd get application.argoproj.io/"*" --ignore-not-found -o name")
    if argo_app_present "${4#*/}"; then echo "$4"; fi
    ;;
  "-n argocd get application.argoproj.io/"*" -o jsonpath={.metadata.deletionTimestamp}")
    argo_app_present "${4#*/}" || exit 1
    if flag root-deleted && [ "${4#*/}" != unmanaged ]; then echo 2026-01-01T00:00:00Z; fi
    ;;
  "-n argocd get application.argoproj.io/"*" -o jsonpath="*)
    argo_app_present "${4#*/}" || exit 1
    remaining "$4"
    ;;
  "-n argocd get appproject.argoproj.io/"*" -o jsonpath="*)
    ns_present argocd || exit 1
    remaining "$4"
    ;;
  "-n argocd get appprojects.argoproj.io -o name")
    if ns_present argocd; then
      for p in $argo_projects; do echo "appproject.argoproj.io/$p"; done
    fi
    ;;
  "-n argocd get applicationsets.argoproj.io -o name")
    flag appsets-deleted || printf '%s\n' applicationset.argoproj.io/apps applicationset.argoproj.io/data
    ;;
  "-n argocd delete application.argoproj.io/platform-root --wait=false")
    mark root-deleted
    echo 'application.argoproj.io "platform-root" deleted'
    ;;
  "-n argocd delete applicationset.argoproj.io/"*" --ignore-not-found --wait=false")
    mark appsets-deleted
    echo "${4%%/*} \"${4#*/}\" deleted"
    ;;
  "-n argocd get pods -l app.kubernetes.io/name=argocd-application-controller --field-selector=status.phase=Running -o name")
    if flag operator-api-error; then
      echo "Unable to connect to the server" >&2
      exit 1
    fi
    if flag argo-controller-up && ! flag helm-uninstalled && ! flag helm-not-found; then echo pod/argocd-application-controller-0; fi
    ;;
  "get namespace "*" -o name")
    ns_present "$3" || exit 1
    echo "namespace/$3"
    ;;
  "delete namespace "*" --wait=false")
    mark "ns-$3-deleted"
    echo "namespace \"$3\" deleted"
    ;;
  "get storageclass platform-data -o name")
    if flag storageclass && ! flag storageclass-deleted; then
      echo storageclass.storage.k8s.io/platform-data
    else
      exit 1
    fi
    ;;
  "delete storageclass platform-data --wait=true --timeout="*)
    mark storageclass-deleted
    echo 'storageclass.storage.k8s.io "platform-data" deleted'
    ;;
  "-n shop get deployments,statefulsets,jobs,ingresses,pods -o name")
    if ! flag labels-removed || flag stuck-shop; then
      printf '%s\n' deployment.apps/orders pod/orders-0
    fi
    ;;
  "get crd clusters.postgresql.cnpg.io -o name" | "get crd rabbitmqclusters.rabbitmq.com -o name" | "get crd databases.postgresql.cnpg.io -o name" | \
    "get crd applications.argoproj.io -o name" | "get crd applicationsets.argoproj.io -o name" | "get crd appprojects.argoproj.io -o name")
    grep -Fxq -- "$3" "$state/crds" || exit 1
    echo "customresourcedefinition.apiextensions.k8s.io/$3"
    ;;
  "-n cnpg-system get pods -l app.kubernetes.io/name=cloudnative-pg --field-selector=status.phase=Running -o name")
    if flag operator-api-error; then
      echo "Unable to connect to the server" >&2
      exit 1
    fi
    if flag cnpg-operator-up; then echo pod/cnpg-controller-manager-0; fi
    ;;
  "-n rabbitmq-system get pods -l app.kubernetes.io/name=rabbitmq-cluster-operator --field-selector=status.phase=Running -o name")
    if flag operator-api-error; then
      echo "Unable to connect to the server" >&2
      exit 1
    fi
    if flag mq-operator-up; then echo pod/rabbitmq-cluster-operator-0; fi
    ;;
  "-n observability get pods -o name")
    if flag stuck-obs-pods || ! flag labels-removed; then
      printf '%s\n' pod/prometheus-kube-prometheus-stack-prometheus-0 pod/kube-prometheus-stack-grafana-0
    fi
    ;;
  "-n observability get persistentvolumeclaims -o name")
    if flag obs-persistent && ! flag obs-pvc-deleted; then
      printf '%s\n' persistentvolumeclaim/prometheus-kube-prometheus-stack-prometheus-db-prometheus-kube-prometheus-stack-prometheus-0 \
        persistentvolumeclaim/kube-prometheus-stack-grafana
    fi
    ;;
  "-n observability delete persistentvolumeclaim/"*" --wait=true --timeout="*)
    mark obs-pvc-deleted
    echo "$4 deleted"
    ;;
  "-n data get databases.postgresql.cnpg.io -o name")
    for o in "$db_orders" "$db_payments"; do
      if exists "$o"; then echo "$o"; fi
    done
    ;;
  "-n data delete database.postgresql.cnpg.io/platform-pg-"*" --wait=false" | "-n data delete $mq --wait=false")
    mark "deleting-$(key "$4")"
    echo "${4%%/*} \"${4#*/}\" deleted"
    ;;
  "-n data get database.postgresql.cnpg.io/platform-pg-"*" --ignore-not-found -o name" | "-n data get $mq --ignore-not-found -o name")
    if exists "$4"; then echo "$4"; fi
    ;;
  "-n data get database.postgresql.cnpg.io/platform-pg-"*" -o jsonpath="* | "-n data get $mq -o jsonpath="*)
    exists "$4" || exit 1
    remaining "$4"
    ;;
  "-n data patch database.postgresql.cnpg.io/platform-pg-"*" --type=json -p "* | "-n data patch $mq --type=json -p "* | \
    "-n argocd patch application.argoproj.io/"*" --type=json -p "* | "-n argocd patch appproject.argoproj.io/"*" --type=json -p "*)
    # Only the exact patch the script is expected to send: test the finalizer at its index, then remove it.
    value="$(printf '%s' "$*" | sed -n 's/.*"op":"test","path":"[^"]*","value":"\([^"]*\)".*/\1/p')"
    position="$(printf '%s' "$*" | sed -n 's/.*"op":"test","path":"\/metadata\/finalizers\/\([0-9]*\)".*/\1/p')"
    current="$(remaining "$4" | sed -n "$((position + 1))p")"
    if [ -z "$value" ] || [ "$value" != "$current" ]; then
      echo "fake kubectl: the patch test failed: expected '$value' at index '$position', found '$current'" >&2
      exit 1
    fi
    mark "cleared-$(key "$4")"
    echo "${4%%/*}/${4#*/} patched"
    ;;
  "-n data get cluster.postgresql.cnpg.io -o name")
    flag pg-deleted || echo cluster.postgresql.cnpg.io/platform-pg
    ;;
  "-n data delete cluster.postgresql.cnpg.io/platform-pg --wait=true --timeout="*)
    mark pg-deleted
    echo 'cluster.postgresql.cnpg.io "platform-pg" deleted'
    ;;
  "-n data get rabbitmqclusters.rabbitmq.com -o name")
    if exists "$mq"; then echo "$mq"; fi
    ;;
  "-n data get statefulset/platform-mq-server -o name")
    if flag mq-survives && ! flag sts-deleted; then
      echo statefulset.apps/platform-mq-server
    else
      exit 1
    fi
    ;;
  "-n data delete statefulset/platform-mq-server --wait=true --timeout="*)
    mark sts-deleted
    echo 'statefulset.apps "platform-mq-server" deleted'
    ;;
  "-n data get pods -o name")
    if flag stuck-pods; then
      echo pod/stuck-0
    else
      flag pg-deleted || echo pod/platform-pg-1
      if ! flag sts-deleted && { exists "$mq" || flag mq-survives; }; then
        echo pod/platform-mq-server-0
      fi
    fi
    ;;
  "-n data get persistentvolumeclaims -o name")
    flag pvc-deleted || printf '%s\n' persistentvolumeclaim/platform-pg-1 persistentvolumeclaim/platform-valkey
    ;;
  "-n data delete persistentvolumeclaim/"*" --wait=true --timeout="*)
    mark pvc-deleted
    echo "$4 deleted"
    ;;
  "get pv -o name")
    if flag stuck-pv || { ! flag pvc-deleted && ! flag no-pv; }; then
      echo persistentvolume/pvc-0123
    fi
    if flag obs-persistent && ! flag obs-pvc-deleted; then
      echo persistentvolume/pvc-4567
    fi
    ;;
  *) unexpected "$@" ;;
esac
