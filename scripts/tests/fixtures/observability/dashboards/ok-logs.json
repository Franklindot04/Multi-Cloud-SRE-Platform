{
  "uid": "ok-logs",
  "title": "Example logs",
  "templating": {
    "list": [
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "query": "label_values({namespace=~\".+\"}, namespace)",
          "refId": "var-namespace"
        },
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "query": "label_values({namespace=~\"$namespace\"}, service_name)",
          "refId": "var-service"
        },
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "search",
        "type": "textbox",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Volume",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log volume by service",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (service_name) (rate({namespace=~\"$namespace\", service_name=~\"$service\"} |~ `(?i)$search` [$__auto]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error lines",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (service_name) (rate({namespace=~\"$namespace\"} | level=\"error\" [$__auto]))"
        }
      ]
    }
  ]
}
