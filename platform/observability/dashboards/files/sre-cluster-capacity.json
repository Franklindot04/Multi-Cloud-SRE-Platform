    {
      "id": 13,
      "type": "timeseries",
      "title": "Allocatable CPU and memory requested, by node",
      "description": "How much of each node's allocatable CPU and memory the pods on it have requested.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\"} * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info)) / sum by (node) (kube_node_status_allocatable{resource=\"cpu\"})",
          "legendFormat": "cpu {{node}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"memory\"} * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info)) / sum by (node) (kube_node_status_allocatable{resource=\"memory\"})",
          "legendFormat": "memory {{node}}"
        }
