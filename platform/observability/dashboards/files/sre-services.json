      "title": "5xx responses per second by route",
      "description": "5xx responses per second. Empty means no route returned a 5xx in this period.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
