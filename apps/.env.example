# Local credentials for apps/docker-compose.data.yml. Copy to apps/.env (which is not tracked) and change
# the values. Everything below is obviously fake and is only ever used on your machine.
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-postgres
ORDERS_DB_PASSWORD=change-me-orders
PAYMENTS_DB_PASSWORD=change-me-payments
VALKEY_PASSWORD=change-me-valkey
RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
