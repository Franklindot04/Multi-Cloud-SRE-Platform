# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
!*.example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.tfplan
tfplan
# Real backend config is local only; the committed template is backend.hcl.example
backend.*.hcl
# .terraform.lock.hcl is committed for root stacks only; modules inherit provider pins from the stack
infra/terraform/modules/**/.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Go
bin/
*.exe
*.test
*.out
vendor/
coverage.txt

# Java
target/
*.class
*.jar
*.war
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# Node
node_modules/

# Editors and IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
credentials*.json
service-account*.json
*-sa-key.json
secrets/
.aws/
.kube/
kubeconfig*

# Helm chart dependencies are downloaded at build time; Chart.lock is committed
platform/addons/*/charts/
platform/argocd/install/charts/
*.tgz

# Application build artifacts, virtual environments and dependency caches.
# go.sum, the hash-pinned requirements*.txt files, mvnw and .mvn/wrapper are committed.
apps/*/bin/
apps/*/coverage.out
apps/orders/.venv/
apps/orders/.pytest_cache/
apps/orders/.ruff_cache/
__pycache__/
*.py[cod]
apps/payments/target/
apps/payments/.mvn/wrapper/maven-wrapper.jar

# Local scratch
tmp/
*.log
